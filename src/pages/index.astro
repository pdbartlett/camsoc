---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Users, Calendar, Mail, Facebook, Linkedin } from 'lucide-astro';

interface RecentEvent {
  title: string;
  date: string;
  location: string;
}

const recentEvents: RecentEvent[] = [
  {
    title: "AGM",
    date: "14 Feb 2026",
    location: "Nettlebed Village Hall",
  },
  {
    title: "Annual Greenlands lunch",
    date: "7 Nov 2025",
    location: "Henley Business School",
  },
];
---

<Layout title="Berkshire and Oxfordshire Cambridge Society">
  <Header />

  <!-- Main Content -->
  <main class="flex-grow max-w-[1440px] mx-auto px-4 py-12 w-full">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Card 1: About the Society -->
      <section class="bg-white rounded-xl shadow-md p-8 border border-slate-100 card-hover flex flex-col">
        <div class="w-12 h-12 cambridge-bg rounded-lg flex items-center justify-center mb-6">
          <Users class="w-6 h-6 text-white" />
        </div>
        <h2 class="text-2xl font-bold mb-4 cambridge-text">About the Society</h2>
        <p class="text-slate-600 mb-4">
          The Berks and Oxon Cambridge Society is long-established, and offers an active programme of excursions, visits, walks etc.
        </p>
        <p class="text-slate-600 mb-2 font-bold uppercase text-xs tracking-widest opacity-70">
          Fixtures in our calendar include:
        </p>
        <ul class="text-slate-600 space-y-2 list-disc pl-5 mb-8 text-sm">
          <li>Annual autumn lunch at Henley Business School (Greenlands) with an external speaker</li>
          <li>Brief AGM with a pot luck lunch and presentation</li>
          <li>Freshers' event at a bar in Reading</li>
          <li>A weekend away in or around May</li>
        </ul>
        <p class="mt-auto pt-6 text-sm text-slate-500 italic border-t border-slate-50">
          Partners and guests are always welcome at our varied events.
        </p>
      </section>

      <!-- Card 2: Events -->
      <section class="bg-white rounded-xl shadow-md p-8 border border-slate-100 card-hover flex flex-col">
        <div class="w-12 h-12 cambridge-bg rounded-lg flex items-center justify-center mb-6">
          <Calendar class="w-6 h-6 text-white" />
        </div>
        <h2 class="text-2xl font-bold mb-4 cambridge-text">Events</h2>
        <div class="space-y-6 mb-8">
          <div class="border-l-4 cambridge-border pl-4">
            <h3 class="font-bold text-xs text-slate-400 uppercase tracking-widest mb-1">Upcoming</h3>
            <p class="font-bold text-lg leading-tight"><i>None at present</i></p>
          </div>
          <div class="border-l-4 border-slate-200 pl-4">
            <h3 class="font-bold text-xs text-slate-400 uppercase tracking-widest mb-1">Recent</h3>
            {recentEvents.map((event) => (
              <div class="mt-2 first:mt-0">
                <p class="font-bold text-lg text-slate-600 leading-tight">{event.title}</p>
                <p class="text-sm text-slate-400">{event.date} • {event.location}</p>
              </div>
            ))}
          </div>
        </div>
        <p class="mt-auto pt-6 text-sm text-slate-500 italic border-t border-slate-50">
          Additional past events will be added as time permits. Please <a href="mailto:secretary@camsoc-berksoxon.org.uk" class="text-blue-600 hover:underline font-semibold not-italic">email us</a> if you have any questions.
        </p>
      </section>

      <!-- Card 3: How to Join -->
      <section class="bg-white rounded-xl shadow-md p-8 border border-slate-100 card-hover flex flex-col">
        <div class="w-12 h-12 cambridge-bg rounded-lg flex items-center justify-center mb-6">
          <Mail class="w-6 h-6 text-white" />
        </div>
        <h2 class="text-2xl font-bold mb-4 cambridge-text">How to Join</h2>
        <p class="text-slate-600 mb-6">
          Membership is open to all alumni of the University of Cambridge residing in Berkshire or Oxfordshire.
        </p>
        
        <div class="bg-slate-50 p-6 rounded-lg border border-slate-200 space-y-6 mb-8">
          <div>
            <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">Get in touch</p>
            <a href="mailto:secretary@camsoc-berksoxon.org.uk" class="text-sm text-blue-800 hover:underline break-all block font-bold">
              secretary@camsoc-berksoxon.org.uk
            </a>
          </div>
          
          <div class="pt-5 border-t border-slate-200">
            <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-4">Find us online</p>
            <div class="flex flex-wrap gap-x-6 gap-y-4">
              <a href="https://www.facebook.com/groups/berksoxon/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-slate-600 hover:text-[#1877F2] transition-colors group">
                <Facebook class="w-5 h-5 group-hover:fill-[#1877F2]/10" />
                <span class="text-sm font-bold">Facebook</span>
              </a>
              <a href="https://www.linkedin.com/groups/9075090/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-slate-600 hover:text-[#0A66C2] transition-colors group">
                <Linkedin class="w-5 h-5 group-hover:fill-[#0A66C2]/10" />
                <span class="text-sm font-bold">LinkedIn</span>
              </a>
            </div>
          </div>
        </div>
        
        <p class="mt-auto pt-6 text-sm text-slate-500 italic border-t border-slate-50">
          Join our groups or email the address above to stay updated on upcoming events.
        </p>
      </section>

    </div>
  </main>

  <Footer />
</Layout>
